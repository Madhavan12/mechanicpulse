# Copy to .env and fill in. Never commit .env.
S3_BUCKET=mechanicpulse-spike-madhavan-2026
AWS_REGION=ap-southeast-2
PORT=3001
WEB_ORIGIN=http://localhost:3000

AWS_REQUEST_CHECKSUM_CALCULATION=WHEN_REQUIRED

# Credentials come from your SSO login (aws sso login --profile mechanicpulse).
# See docs/aws-setup.md. Do not put keys in this file.
AWS_PROFILE=mechanicpulse

# Local dev Postgres — see docs/data-model.md for schema/seed setup.
DATABASE_URL=postgres://postgres:devpass@localhost:5433/mechanicpulse_dev

# Dev only — a throwaway secret is fine locally, but this must be a real
# secret (not committed) once this talks to anything beyond localhost.
JWT_SECRET=dev-secret-change-me

# SMS. Leave SMS_PROVIDER unset (or "console") in dev and CI: texts are logged,
# never sent. For real texts set all four below (secrets come from the secret
# store, never the repo) — see docs/product-decisions.md.
# SMS_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=+614xxxxxxxx   # a number, or a Messaging Service SID starting MG
# The API's public address, so Twilio can report delivery. Unset = no receipts.
# PUBLIC_API_URL=https://api.example.com

